-- UI Элемент: Быстрый клик (Атака)
local ToggleClick = Tabs.Main:AddToggle("AutoClick", {Title = "Авто-Атака (Fast Click)", Default = false})
ToggleClick:OnChanged(function()
    _G.Configs.AutoClicker = ToggleClick.Value
    task.spawn(function()
        while _G.Configs.AutoClicker do
            task.wait(0.1)
            pcall(function()
                local tool = getWeapon()
                if tool then
                    if not LocalPlayer.Character:FindFirstChild(tool.Name) then
                        LocalPlayer.Character.Humanoid:EquipTool(tool)
                    end
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(850, 520))
                end
                VirtualUser:TypeKey("z")
                VirtualUser:TypeKey("x")
            end)
        end
    end)
end)

-- UI Элемент: Стягивание мобов в кучу (Bring Mobs)
local ToggleBring = Tabs.Main:AddToggle("BringMobsToggle", {Title = "Стягивать мобов в одну точку", Default = false})
ToggleBring:OnChanged(function()
    _G.Configs.BringMobs = ToggleBring.Value
    task.spawn(function()
        while _G.Configs.BringMobs do
            task.wait(0.2)
            pcall(function()
                local playerPos = LocalPlayer.Character.HumanoidRootPart.Position
                for _, enemy in pairs(workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        if (enemy.HumanoidRootPart.Position - playerPos).Magnitude < 350 then
                            enemy.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame * CFrame.new(0, -1, -5)
                            enemy.HumanoidRootPart.CanCollide = false
                            if enemy.Humanoid:FindFirstChild("Animator") then enemy.Humanoid.Animator:Destroy() end
                        end
                    end
                end
            end)
        end
    end)
end)

-- UI Элемент: Основной умный авто-фарм уровней
local ToggleFarm = Tabs.Main:AddToggle("AutoFarmLevel", {Title = "Умный Авто Фарм Уровней", Default = false})
ToggleFarm:OnChanged(function()
