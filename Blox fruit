-- ЧАСТЬ 3: ФУНКЦИИ ESP И ПРИВЕТСТВИЕ AMEBA HUB
-- ====================================================================
local espFolder = Instance.new("Folder", game.CoreGui)
espFolder.Name = "Premium_ESP_Storage"

-- Функция отрисовки и обновления ESP
local function refreshFruitESP()
    espFolder:ClearAllChildren()
    if not _G.Configs.FruitESP then return end
    
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Tool") and (string.find(obj.Name, "Fruit") or string.find(obj.Name, "Фрукт")) then
            local handle = obj:FindFirstChild("Handle") or obj
            
            -- Розовая 3D обводка (Box)
            local box = Instance.new("BoxHandleAdornment", espFolder)
            box.Size = Vector3.new(3, 3, 3)
            box.AlwaysOnTop = true
            box.ZIndex = 5
            box.Color3 = Color3.fromRGB(255, 0, 128)
            box.Adornee = handle
            box.Transparency = 0.4

            -- Текст над фруктом
            local billboard = Instance.new("BillboardGui", espFolder)
            billboard.AlwaysOnTop = true
            billboard.Size = UDim2.new(0, 150, 0, 50)
            billboard.Adornee = handle
            
            local label = Instance.new("TextLabel", billboard)
            label.Size = UDim2.new(1, 0, 1, 0)
            label.Text = obj.Name
            label.TextColor3 = Color3.fromRGB(255, 255, 255)
            label.TextStrokeTransparency = 0
            label.BackgroundTransparency = 1
            label.TextScaled = true
        end
    end
end

-- UI Элемент: Переключатель ESP фруктов
local ToggleESP = Tabs.Visuals:AddToggle("FruitESPToggle", {Title = "Подсветка Дьявольских Фруктов", Default = false})
ToggleESP:OnChanged(function()
    _G.Configs.FruitESP = ToggleESP.Value
    refreshFruitESP()
end)

-- Авто-обновление при появлении нового фрукта на сервере
workspace.ChildAdded:Connect(function()
    if _G.Configs.FruitESP then
        task.wait(0.5)
        refreshFruitESP()
    end
end)

